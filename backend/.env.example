# =============================================================================
# Cretona backend — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; THIS file is committed and
# must list every key with a placeholder (ADR-005). If you add a key to the
# config loader, add it here in the same commit or the next person's boot fails
# with no clue why.
#
# Nothing in this file may ever appear in an Android build. See docs/SECURITY.md.
# =============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
#
# DO NOT hand-edit the lines below. Copy the real values from the dashboard:
#   Connect (top bar) -> ORMs tab -> Prisma
# That page prints both variables with your actual pooler hostname already
# filled in. The host is NOT predictable -- it varies by project and region --
# so building it from this template produces "Can't reach database server".
#
# DATABASE_URL  transaction pooler, port 6543, used at runtime
# DIRECT_URL    session pooler,     port 5432, used by migrations and db pull
#               (migrations cannot run through the transaction pooler)
#
# Use the SESSION pooler for DIRECT_URL, not "Direct connection" -- the latter
# is IPv6-only without the IPv4 add-on and will not resolve on most networks.
#
# The password is the database password from project creation, not your account
# password and not an API key. URL-encode any special characters in it:
#   @ -> %40    # -> %23    / -> %2F    ? -> %3F    : -> %3A
# An unencoded @ breaks host parsing and looks exactly like a network failure.
# -----------------------------------------------------------------------------
DATABASE_URL=<paste from Connect -> ORMs -> Prisma>
DIRECT_URL=<paste from Connect -> ORMs -> Prisma>

# -----------------------------------------------------------------------------
# Supabase — Settings → API
#
# SERVICE_ROLE_KEY bypasses RLS entirely. It is the single most dangerous value
# in this file. Server only, never logged, never in a client.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

SUPABASE_UPLOADS_BUCKET=uploads
SUPABASE_VIDEOS_BUCKET=videos
SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# AI providers (ADR-004: Runway launches, Kling second)
#
# A provider is registered at boot only if its key is present, so a provider
# with no key here can never be selected.
# -----------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=runway
RUNWAY_API_KEY=
# KLING_API_KEY=

# -----------------------------------------------------------------------------
# Quota and rate limiting (ADR-007)
#
# The limit is provisional until real per-generation pricing is known.
# -----------------------------------------------------------------------------
GENERATION_QUOTA_LIMIT=10
GENERATION_QUOTA_WINDOW=P1D
RATE_LIMIT_GENERATION_PER_MIN=5
RATE_LIMIT_DEFAULT_PER_MIN=120

# -----------------------------------------------------------------------------
# Job runner (ADR-003)
# -----------------------------------------------------------------------------
POLL_INTERVAL_MS=10000
POLL_BACKOFF_AFTER_MS=120000
POLL_BACKOFF_INTERVAL_MS=30000
GENERATION_TIMEOUT_SECONDS=600
MAX_GENERATION_ATTEMPTS=3
