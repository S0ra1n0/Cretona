<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Auth sessions are encrypted with a device-bound Android Keystore key.
         Restoring their ciphertext onto another device cannot succeed, so no
         app data is eligible for cloud backup or device-to-device transfer. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
