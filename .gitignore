# Secrets and machine-local configuration
.env
.env.*
!.env.example
env
local.properties
**/local.properties
!**/local.properties.example
*.keystore
*.jks
# Access token for scripts/verify-live-runtime.py. Short-lived, but a bearer
# credential all the same — it belongs in a file rather than shell history.
.token
**/.token

# Throwaway local dev-mode backend data for emulator testing (SQLite db, seed
# script). Not the live-configured backend/.env profile.
backend/.devdata/

# Generated media: providers write per-job files and re-hosting writes
# owner-scoped copies under backend/assets/<user-id>/. The bundled demo clip
# is a committed fixture and stays tracked.
backend/assets/*/

