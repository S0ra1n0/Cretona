# Copy to .env. Never commit the real file.
CRETONA_ENVIRONMENT=development
# debug | info | warning | error. Logs are newline-delimited JSON with
# central redaction; secrets never reach them.
CRETONA_LOG_LEVEL=info
# Startup rejects dev auth when environment is production.
CRETONA_AUTH_MODE=dev
# sqlite is the credential-free local profile; postgres targets Supabase.
CRETONA_DATABASE_BACKEND=sqlite
CRETONA_DATABASE_PATH=data/cretona.db
# Required when CRETONA_DATABASE_BACKEND=postgres. Carries a password, so it is
# treated as a secret: never commit a filled-in value.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
CRETONA_DATABASE_URL=
# Submissions allowed per project before a retry is refused.
CRETONA_MAX_GENERATION_ATTEMPTS=3

# Background poller. Advances in-flight generations without waiting for a
# client to read them.
CRETONA_POLLER_ENABLED=true
CRETONA_POLL_INTERVAL_SECONDS=5
CRETONA_POLL_BATCH_SIZE=20

# Thumbnails need the ffmpeg binary on PATH. Without it thumbnailUrl stays
# null; generations still succeed.
CRETONA_THUMBNAILS_ENABLED=true
CRETONA_FFMPEG_PATH=ffmpeg
CRETONA_THUMBNAIL_SEEK_SECONDS=1

# Burst protection, per caller per minute. In-memory, so this is per process
# rather than a global ceiling; the quota below is what protects the budget.
CRETONA_RATE_LIMIT_ENABLED=true
CRETONA_RATE_LIMIT_DEFAULT_PER_MIN=120
CRETONA_RATE_LIMIT_GENERATION_PER_MIN=10

# Spend control (ADR-007). Rate limiting stops bursts; only this protects the
# budget. Generations per user per rolling window.
CRETONA_GENERATION_QUOTA_LIMIT=10
CRETONA_GENERATION_QUOTA_WINDOW_HOURS=24
CRETONA_MEDIA_DIR=assets
CRETONA_DEFAULT_VIDEO_PROVIDER=fake

# Media storage. local keeps files on disk for the credential-free profile;
# supabase stores them in a bucket and returns bounded signed URLs.
CRETONA_STORAGE_BACKEND=local
# Both required when CRETONA_STORAGE_BACKEND=supabase.
# The service-role key bypasses RLS: server-side only, never in the app.
CRETONA_SUPABASE_URL=
CRETONA_SUPABASE_SERVICE_ROLE_KEY=
CRETONA_SUPABASE_UPLOADS_BUCKET=uploads
CRETONA_SUPABASE_VIDEOS_BUCKET=videos
# Read-URL lifetime. Bounded to 60..604800 so a signed URL cannot be permanent.
CRETONA_SIGNED_URL_TTL_SECONDS=3600

# Supabase identity. Required when CRETONA_AUTH_MODE=supabase; startup fails
# without it. Read it from Supabase > Settings > API > JWT secret and keep it
# out of Git, the Android app, and chat. Leave blank here.
CRETONA_SUPABASE_JWT_SECRET=
CRETONA_SUPABASE_JWT_AUDIENCE=authenticated
# Optional. When set, the token issuer must match exactly.
# Format: https://<project-ref>.supabase.co/auth/v1
CRETONA_SUPABASE_JWT_ISSUER=
# Clock-skew tolerance in seconds for exp/nbf.
CRETONA_SUPABASE_JWT_LEEWAY_SECONDS=0

# Free local prompt LLM. Set deterministic when Ollama is not installed.
CRETONA_PROMPT_LLM_PROVIDER=deterministic
CRETONA_OLLAMA_BASE_URL=http://127.0.0.1:11434
CRETONA_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
CRETONA_OLLAMA_TIMEOUT_SECONDS=45
CRETONA_OLLAMA_NUM_CTX=4096
CRETONA_OLLAMA_NUM_PREDICT=180
CRETONA_OLLAMA_TEMPERATURE=0.2

# Fake provider timing for the repeatable zero-spend demo.
CRETONA_FAKE_POLLS_BEFORE_COMPLETE=1
CRETONA_FAKE_VIDEO_FILENAME=demo-output.mp4
